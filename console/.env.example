# ------------------------------------------------------------------
# Console configuration.
#
#   cp console/.env.example console/.env
#
# Read by the Next.js SERVER and published to the browser as
# window.__RUNTIME_CONFIG__ by src/app/runtime-config.js/route.ts;
# src/lib/runtime-config.ts reads it there through lazy getters.
#
# Run time, not build time. `next build` inlines every NEXT_PUBLIC_* read into
# the client bundle, which would pin a built image to one API URL. These
# APP_* names avoid that, so one image runs in any environment and changing a
# value is a restart rather than a rebuild.
#
# Next loads this file in `npm run dev` too, so the same values serve both
# Docker and host-native development.
#
# Not committed -- console/.env is gitignored.
# ------------------------------------------------------------------

# The backend REST API, always on the page's own host: the browser never calls
# an API domain. In Docker the console's nginx gateway serves the app and
# forwards /api and /uploads to the API; in `npm run dev` next.config.ts
# forwards the same two paths to API_PROXY_TARGET, so a tenant business domain
# such as http://acme.localhost:3000 works locally too.
#
# Because this is relative, every request the browser makes is same-origin:
#
#   getApiUrl()        -> "/api/v1"   -> fetch("/api/v1/system/login")
#   getUploadsOrigin() -> ""          -> uploadUrl(p) -> "/uploads/<p>"
#
# That is what removes CORS from the browser path, and what lets the
# sameSite=strict auth cookies work on any hostname - including each tenant
# business domain, which gets its own cookie jar.
#
# Native mobile apps call the same origin, spelled absolutely:
# https://<host>/api/v1 (docs/guide/mobile-clients).
#
# An absolute URL still works but reintroduces CORS, and backend/.env's
# CORS_ORIGINS would then have to name this console's exact origin. Never a
# compose service name such as http://api:4000: those resolve only
# container-to-container, and this value is handed to the browser.
APP_API_URL=/api/v1

# Where `npm run dev` forwards /api and /uploads, via src/middleware.ts. Dev
# only - in Docker the nginx gateway does it, and the middleware returns early
# in production.
API_PROXY_TARGET=http://localhost:4000

# There is NO API key to configure here. The API requires one on every call,
# and the console fetches its own from GET /system/setup/status at run time
# (src/lib/console-key.ts) - the setup wizard issues it. Nothing to keep in
# step, and a reissued key needs no rebuild.

# Fallback application name: the browser tab title, and what shows until the
# DB-backed `app.name` setting loads. The setup wizard writes the real value,
# and the App Settings page can change it later. Keep it roughly in step with
# backend/.env's APP_NAME so both sides agree before that row exists.
APP_NAME=FTTDDWA

# OpenStreetMap tile server used by the Places/Streets location picker (no API
# key required). Override to point at a self-hosted tile server if needed.
APP_OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# ------------------------------------------------------------------
# NEXT_PUBLIC_* fallbacks
#
# src/lib/runtime-config.ts falls back to NEXT_PUBLIC_API_URL,
# NEXT_PUBLIC_APP_NAME and NEXT_PUBLIC_OSM_TILE_URL when the APP_* names above
# are unset. They are build-time inlined, so prefer the APP_* names and treat
# these as a compatibility path only.
# ------------------------------------------------------------------
