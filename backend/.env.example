# ------------------------------------------------------------------
# App
# ------------------------------------------------------------------
APP_ENV=development
PORT=4000
# Short form of FEDERATION OF TAMILNADU TENT DEALERS & DECORATORS WELFARE
# ASSOCIATION. Drives the browser tab title, the Swagger title and the
# console sidebar, so keep it short - the full name lives in the README.
APP_NAME="FTTDDWA"

# ------------------------------------------------------------------
# API versioning (URI-based). Controllers with no explicit @Controller
# version fall back to this. Ex. API_VERSION=1 -> /api/v1/...
# ------------------------------------------------------------------
API_VERSION=1

# ------------------------------------------------------------------
# Database (PostgreSQL)
#
# ONE FILE SERVES BOTH. These POSTGRES_* values create the database in the
# Docker data stack (backend/docker/data), and backend/docker/services/api
# composes the container's DATABASE_URL from them -- so POSTGRES_DB is the
# single source of the database name.
#
# DATABASE_URL below is for host-native `npm run dev`, pointing at the
# container's 127.0.0.1 port. The api container overrides it with the
# in-network address, so both work from this one file.
# ------------------------------------------------------------------
POSTGRES_USER=fttddwa
POSTGRES_PASSWORD=change_me_before_deploying
POSTGRES_DB=fttddwa_db

DATABASE_URL="postgresql://fttddwa:change_me_before_deploying@localhost:5433/fttddwa_db?schema=public"

# Point api and migrate at a different PostgreSQL (a managed one, say)
# instead of the data stack. Must be a postgresql:// URL.
# DOCKER_DATABASE_URL=

# Bounds Prisma's pool inside Docker. Its default (2 x CPUs + 1) grows with
# the host's CPU count and can outgrow max_connections.
API_DB_POOL=10

# ------------------------------------------------------------------
# JWT / Auth
# ------------------------------------------------------------------
JWT_ACCESS_SECRET=dev-access-secret-change-me-in-production-3f9a1c
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-in-production-7b2e8d
JWT_REFRESH_EXPIRES_IN=7d

# Cookies (refresh token / CSRF). Set COOKIE_SECURE=true behind HTTPS.
# Cookies are sameSite=strict and host-only (no explicit domain), so both
# apps must share one registrable domain in production.
COOKIE_SECURE=false

# ------------------------------------------------------------------
# CORS (comma separated origins)
#
# The console's nginx gateway serves the app and the API from one origin, so
# the browser makes no cross-origin requests and this no longer affects it.
# It still applies to anything calling the API directly, and validation
# requires it non-empty (an empty value would reject every cross-origin
# request silently).
#
# Always the origin as the BROWSER sees it - never a compose service name
# like http://console:3000, which resolves only container-to-container.
# ------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000

# ------------------------------------------------------------------
# Reverse proxy
#
# Hop count for Express's `trust proxy`, so the real client address is used
# for rate limiting rather than the gateway's. 1 is correct both with and
# without the Caddy edge, because the gateway SETS X-Forwarded-For to a single
# address instead of appending (console/nginx/snippets/proxy.conf).
#
# Leave empty only when the API is exposed directly with no proxy in front:
# with a proxy and no value, every client shares one throttle bucket.
# ------------------------------------------------------------------
TRUST_PROXY=1

# ------------------------------------------------------------------
# Rate limiting
# ------------------------------------------------------------------
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
# Budget for native app device types (x-device-type: androidApp | iosApp |
# desktopApp). Mobile users share carrier NAT addresses, so thousands of
# unrelated subscribers can sit behind one IP and the browser-sized limit
# above would lock out whole carrier ranges. This only widens the global
# default - per-route limits such as login's 5/min still apply to apps.
THROTTLE_LIMIT_APP=1000

# ------------------------------------------------------------------
# Storage (local | s3). When STORAGE_DRIVER=s3, S3_* vars are required.
# Only the file PATH is stored in DB, never a full URL.
# ------------------------------------------------------------------
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=public/uploads
# Files that must NOT be publicly readable (member ID cards). LOCAL_STORAGE_DIR
# is served as static /uploads, OUTSIDE the guard pipeline; this one never is.
# With STORAGE_DRIVER=s3 it becomes a key prefix in the same bucket, and that
# prefix must not be public-read.
PRIVATE_STORAGE_DIR=storage/private
S3_BUCKET=
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# ------------------------------------------------------------------
# Swagger
# ------------------------------------------------------------------
SWAGGER_ENABLED=true
SWAGGER_PATH=docs

# ------------------------------------------------------------------
# Docker: host ports and bind addresses
#
# Every published port is a key here. Set *_BIND to 127.0.0.1 when a reverse
# proxy fronts the stack -- Docker's published ports bypass a host firewall
# such as UFW. Postgres is always 127.0.0.1-only.
# ------------------------------------------------------------------
# 5433 so a natively installed Postgres on 5432 does not collide.
POSTGRES_HOST_PORT=5433
# The console's nginx gateway is the only public entry point - browsers and
# native mobile apps both reach the API through it, so the API publishes no
# port of its own. Set CONSOLE_HTTP_BIND=127.0.0.1 when the Caddy edge fronts
# it in production.
CONSOLE_HTTP_PORT=3000
CONSOLE_HTTP_BIND=0.0.0.0

# ---- Gateway (console/nginx) ----
# The API as the gateway dials it, over the fttddwa-app network.
NGINX_API_UPSTREAM=api:4000
# Must stay above the API's own 5 MB upload limit; nginx defaults to 1m.
NGINX_CLIENT_MAX_BODY_SIZE=10m
NGINX_PROXY_TIMEOUT=60s
CONSOLE_GATEWAY_CPUS=0.5
CONSOLE_GATEWAY_MEMORY=128m

# ---- Shared proxy network ----
# Change the subnet only if it clashes with a VPN or an existing Docker
# network, and keep PROXY_EDGE_IP inside it. Declared in both
# console/docker-compose.yml and backend/docker/edge/compose.yml.
PROXY_NETWORK_SUBNET=172.31.251.0/24
PROXY_EDGE_IP=172.31.251.20

# ------------------------------------------------------------------
# Domains and the edge (docs/guide/domains)
#
# Each business's own domains are added in the system console, not here. These
# are the hostnames of the SYSTEM console itself, comma separated, with no
# port (nginx strips it before the API sees it).
#
# Empty is fine locally: *.localhost always gets a certificate from Caddy's
# own CA. But ON A PRODUCTION SERVER, SET THIS BEFORE THE FIRST HTTPS VISIT.
# The edge issues a certificate only for a hostname the API already knows - a
# host listed here, or an enabled business domain. On a fresh install there
# are no business domains yet, so leaving this empty means NO hostname can get
# one, including the console you would use to add the first domain, and the
# browser shows only ERR_SSL_PROTOCOL_ERROR. The API warns about this at
# startup. It is read once at construction, so changing it needs
# `docker compose up -d --force-recreate api`, not a restart.
# ------------------------------------------------------------------
SYSTEM_PORTAL_HOSTS=

# Let's Encrypt account email, for expiry notices. Unset omits the directive.
ACME_EMAIL=
# Optional. Empty: Caddy's own CA for localhost/*.localhost, Let's Encrypt for
# public domains. local_certs: Caddy's own CA for every name (a staging server
# with no public DNS).
EDGE_TLS=

# ------------------------------------------------------------------
# ENCRYPTION AT REST
# ------------------------------------------------------------------
# AES-256 key for values the application must be able to read back: the
# console's own API key today, encrypted settings later. 64 hex characters.
#
# OPTIONAL. Left empty, it is derived from JWT_ACCESS_SECRET, so a fresh
# install needs no edit here before the setup wizard can run - the wizard
# issues the console's API key itself and stores it with this.
#
# SET IT EXPLICITLY ON ANYTHING LONG-LIVED. With the derived fallback,
# rotating JWT_ACCESS_SECRET makes every stored encrypted value unreadable;
# recover with `npm run console-key` and by re-entering encrypted settings.
#
#   openssl rand -hex 32
# ------------------------------------------------------------------
SETTINGS_ENCRYPTION_KEY=

# Shared secret the edge sends with its on-demand TLS check, so the ask
# endpoint is not open to anything that can reach the API. Generate with
# `openssl rand -hex 32`. Empty accepts the ask unauthenticated, which is fine
# locally because the console gateway 404s that path publicly.
EDGE_ASK_KEY=

# The edge's ports. Let's Encrypt needs 80 and 443 reachable from the
# internet: HTTP-01 validates on 80, so 443 alone is not enough.
EDGE_HTTP_PORT=80
EDGE_HTTPS_PORT=443
EDGE_BIND=0.0.0.0
EDGE_CPUS=0.5
EDGE_MEMORY=128m

# ------------------------------------------------------------------
# Docker: images, resources and logging
# ------------------------------------------------------------------
# IMAGE_REGISTRY=registry.example.com/
IMAGE_TAG=latest

API_CPUS=1.5
API_MEMORY=768m
CONSOLE_CPUS=1
CONSOLE_MEMORY=512m
POSTGRES_SHM_SIZE=256m

LOG_MAX_SIZE=10m
LOG_MAX_FILE=5

# An absolute host folder for uploads instead of the fttddwa-uploads volume.
# Must be writable by UID 1000 (the image's `node` user).
# UPLOADS_HOST_DIR=/srv/fttddwa/uploads
