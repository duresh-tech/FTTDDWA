# ------------------------------------------------------------------
# Member app configuration.
#
#   cp member-app/.env.example member-app/.env
#
# BUILD-time, not run time. flutter_dotenv bundles this file into the binary as
# an asset, so changing a value is a rebuild rather than a restart -- unlike
# console/.env, which a running server re-reads. One build therefore serves one
# association.
#
# Not committed -- member-app/.env is gitignored, and it holds a real API key.
# ------------------------------------------------------------------

# The REST API, absolute and including the version prefix.
#
# In production this is the association's OWN domain: Caddy fronts it and the
# console's gateway forwards /api to the API service, so there is no separate
# API hostname to configure (docs/guide/domains).
#
# From an Android emulator, 10.0.2.2 is the host machine -- `localhost` would
# be the emulator itself. An iOS simulator shares the host's network, so
# localhost works there.
APP_API_URL=https://acme.example.com/api/v1

# The association's hostname, sent as the `Origin` header on every request.
#
# THIS is what tells the API which association the app serves. The API resolves
# the business from the hostname and accepts no business id in any request body,
# so without this login and registration return
# 404 "This address does not serve a member portal".
#
# It must match a row in tenant_business_domains exactly: no scheme, no port,
# lowercase. Add it under the business in the console first.
#
# In production this is just the APP_API_URL host. The two differ only in
# development, where the API is reached at an address that is not a business
# domain.
APP_ASSOCIATION_HOST=acme.example.com

# This app's own API key.
#
# Every API route requires one -- the guard fails closed. Registration would
# work without it (public/member/* is exempt) but login and the ID card would
# return 401.
#
# Issue a key for this app in the console under API Keys. Do NOT reuse the
# console's own key: a key names the calling application, and revoking a shared
# one would lock out the console too.
APP_API_KEY=fttddwa_xxxxx_00000000.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Shown on the splash and in the app bar until GET public/member/site supplies
# the association's real name.
APP_NAME=FTTDDWA
