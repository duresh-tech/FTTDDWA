<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.

         It is also declared in the main manifest, because the app itself needs
         it in release builds — see the comment there.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Permits cleartext HTTP to the local development host ONLY. Merged into
         debug builds only, so release stays HTTPS-only. See the config file. -->
    <application android:networkSecurityConfig="@xml/network_security_config" />
</manifest>
