<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG ONLY. This file lives under src/debug, so it is merged into debug
  builds and is absent from release ones.

  Android has blocked cleartext HTTP by default since API 28, and local
  development serves the API over plain HTTP: APP_API_URL is
  http://10.0.2.2:3000/api/v1, where 10.0.2.2 is the host machine as seen from
  the emulator. Without this, every request fails with a CLEARTEXT_NOT_PERMITTED
  error that reads like a server fault.

  The exception is deliberately narrow — these three addresses and nothing
  else. A blanket android:usesCleartextTraffic="true" would also permit
  cleartext to any real host, and on a build type that is easy to ship by
  accident.

  Release builds inherit the platform default, so production is HTTPS-only.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- The host machine, from an Android emulator. -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <!-- A device port-forwarded with `adb reverse`. -->
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
